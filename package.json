{
  "name": "@rin/root",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "rin": "node --import tsx/esm rin/cli/rin/src/bin.ts",
    "build": "pnpm run rin:typecheck && pnpm run rin:build",
    "build:rin": "tsc -b rin/tsconfig.json",
    "typecheck": "pnpm run rin:typecheck",
    "rin:typecheck": "tsc -b rin/tsconfig.json",
    "rin:build": "pnpm --filter @rin/web-ui run build",
    "test": "pnpm run rin:test",
    "rin:test": "vitest run -c rin/vitest.config.ts",
    "rin:test:coverage": "vitest run -c rin/vitest.config.ts --coverage",
    "rin:lint": "oxlint -c rin/.oxlintrc.json rin",
    "rin:hygiene": "tsx rin/scripts/rin-gates.ts check",
    "rin:smoke": "node rin/scripts/run-smokes.mjs",
    "rin:metadata": "tsx rin/scripts/verify-rin-metadata.ts",
    "check": "pnpm run rin:typecheck && pnpm run rin:test && pnpm run rin:lint && pnpm run rin:smoke && pnpm run rin:metadata",
    "publish:rin": "bash rin/scripts/publish-rin.sh",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@rin/brief": "workspace:^",
    "@rin/doctor": "workspace:^",
    "@rin/knowledge-graph": "workspace:^",
    "@rin/monitor": "workspace:^",
    "@rin/repository": "workspace:^",
    "@rin/review": "workspace:^",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.8",
    "js-yaml": "^4.3.1",
    "lefthook": "^2.1.9",
    "mdast": "^3.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "oxlint": "1.76.0",
    "publint": "^0.3.21",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
