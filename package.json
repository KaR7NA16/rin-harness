{
  "name": "@rin/root",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Rin local-first runtime and developer platform for auditable long-lived AI companions.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "start": "node --import tsx/esm apps/cli/src/bin.ts",
    "dev": "pnpm run start",
    "build": "pnpm run typecheck && pnpm run build:web",
    "build:web": "pnpm --filter @rin/web run build",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run -c vitest.config.ts",
    "test:coverage": "vitest run -c vitest.config.ts --coverage",
    "test:release": "pnpm --filter @rin/desktop run release:verify:test",
    "bench:memory": "tsx packages/domains/memory/scripts/benchmark-memory.ts",
    "lint": "oxlint -c .oxlintrc.json apps packages tooling vitest.config.ts",
    "hygiene": "tsx tooling/gates/runner.ts check",
    "smoke": "node tooling/gates/run-smokes.mjs",
    "metadata": "tsx tooling/gates/verify-metadata.ts",
    "sync:references": "node tooling/generators/sync-references.mjs",
    "check": "pnpm run metadata && pnpm run hygiene && pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run test:release && pnpm run smoke",
    "publish:packages": "bash tooling/scripts/publish-rin.sh",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@rin/authoring": "workspace:^",
    "@rin/health": "workspace:^",
    "@rin/knowledge": "workspace:^",
    "@rin/assets": "workspace:^",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/node": "^22.20.0",
    "@vitest/coverage-v8": "^4.1.8",
    "js-yaml": "^4.3.1",
    "lefthook": "^2.1.9",
    "mdast": "^3.0.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "oxlint": "1.76.0",
    "publint": "^0.3.21",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
