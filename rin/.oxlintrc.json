{
  "$schema": "../node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {
    "correctness": "off"
  },
  // The root dsh config sets this to "warn". rin keeps it off because the
  // rin:lint script (oxlint -c rin/.oxlintrc.json) has no positional path, so
  // oxlint walks the whole repo; dsh files then surface ~150 "unused disable
  // directive" warnings that belong to dsh rules, not rin.
  "options": {
    "reportUnusedDisableDirectives": "off"
  },
  "env": {
    "builtin": true
  },
  // Both ignorePatterns and overrides[].files resolve WITHIN this config file's
  // directory (rin/); ".." escapes are rejected. So the whole-repo scan cannot
  // be narrowed to rin/ from here, and the file globs below are config-relative
  // (the task spec wrote them cwd-relative as rin/*/*/src, which does not match).
  // These only prune rin build artifacts + smoke scripts.
  "ignorePatterns": [
    "**/node_modules/**",
    "**/lib/**",
    "**/dist/**",
    "**/*.smoke.ts",
    "**/*.js",
    "**/*.mjs",
    "**/*.config.ts"
  ],
  "overrides": [
    {
      // Reuses dsh shared strict rules (root .oxlintrc.json override #1), retargeted
      // at rin packages. type-aware rules are intentionally OMITTED: oxlint 1.76 +
      // oxlint-tsgolint 7.x removed baseUrl, which web/web-ui/tsconfig.json still
      // sets, and type-aware mode is one global flag; enabling it makes web-ui fail
      // with "Invalid tsconfig". The rules below are the non-type-aware subset
      // (verified via oxlint --rules --format json, type_aware=false).
      "files": [
        "*/*/src/**/*.{ts,tsx}",
        "*/*/tests/**/*.{ts,tsx}",
        "web/web-ui/src/**/*.{ts,tsx}"
      ],
      "rules": {
        "no-var": "error",
        "prefer-const": "error",
        "prefer-rest-params": "error",
        "prefer-spread": "error",
        "no-array-constructor": "error",
        "no-unused-expressions": "error",
        "no-unused-vars": [
          "error",
          {
            "argsIgnorePattern": "^_",
            "varsIgnorePattern": "^_",
            "caughtErrorsIgnorePattern": "^_"
          }
        ],
        "no-useless-constructor": "error",
        "typescript/ban-ts-comment": [
          "error",
          {
            "minimumDescriptionLength": 10
          }
        ],
        "typescript/no-duplicate-enum-values": "error",
        "typescript/no-dynamic-delete": "error",
        "typescript/no-empty-object-type": "off",
        "typescript/no-explicit-any": "error",
        "typescript/no-extra-non-null-assertion": "error",
        "typescript/no-extraneous-class": "error",
        "typescript/no-invalid-void-type": "off",
        "typescript/no-misused-new": "error",
        "typescript/no-namespace": "off",
        "typescript/no-non-null-asserted-nullish-coalescing": "error",
        "typescript/no-non-null-asserted-optional-chain": "error",
        "typescript/no-require-imports": "error",
        "typescript/no-this-alias": "error",
        "typescript/no-unnecessary-type-constraint": "error",
        "typescript/no-unsafe-declaration-merging": "error",
        "typescript/no-unsafe-function-type": "error",
        "typescript/no-wrapper-object-types": "error",
        "typescript/prefer-as-const": "error",
        "typescript/prefer-literal-enum-member": "error",
        "typescript/prefer-namespace-keyword": "error",
        "typescript/triple-slash-reference": "error",
        "typescript/unified-signatures": "error",
        "no-void": "off"
      },
      "plugins": [
        "typescript"
      ]
    }
  ]
}
