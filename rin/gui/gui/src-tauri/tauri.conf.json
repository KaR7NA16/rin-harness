{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rin",
  "version": "0.1.0",
  "identifier": "com.rin.harness",
  "build": {
    "frontendDist": "../../../web/web-ui/dist",
    "devUrl": "http://127.0.0.1:8320"
  },
  "app": {
    "windows": [
      {
        "title": "rin",
        "width": 1440,
        "height": 960,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' http://127.0.0.1:8320 http://127.0.0.1:* ws://127.0.0.1:* ws://localhost:* http://localhost:*; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installerHooks": "../scripts/installer.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/rin-sidecar"
    ],
    "resources": {
      "../../../core/repository/builtin/": "resources/repository/"
    }
  }
}
