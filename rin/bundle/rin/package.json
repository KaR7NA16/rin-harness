{
  "name": "@rin/bundle",
  "description": "rin assembly layer: dsh-base + the full @rin host plugin family as one zero-intrusion bundle (no dsh-web-app)",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-name/rin-harness.git"
  },
  "homepage": "https://github.com/your-name/rin-harness",
  "bugs": {
    "url": "https://github.com/your-name/rin-harness/issues"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/types/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/types/index.js"
    },
    "./cordis.yml": "./src/cordis.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/types/**/*",
    "src/cordis.yml"
  ],
  "dependencies": {
    "@deepseek-ai/dsh-base": "workspace:^",
    "@deepseek-ai/dsh-code-runtime": "workspace:^",
    "@deepseek-ai/dsh-code-runtime-worker-thread": "workspace:^",
    "@deepseek-ai/dsh-lsp": "workspace:^",
    "@deepseek-ai/dsh-lsp-stdio": "workspace:^",
    "@deepseek-ai/dsh-schedule": "workspace:^",
    "@deepseek-ai/dsh-storage": "workspace:^",
    "@deepseek-ai/dsh-storage-domain": "workspace:^",
    "@deepseek-ai/dsh-storage-json": "workspace:^",
    "@deepseek-ai/dsh-terminal": "workspace:^",
    "@deepseek-ai/dsh-terminal-bash": "workspace:^",
    "@deepseek-ai/dsh-time-context": "workspace:^",
    "@deepseek-ai/dsh-tool-bash-persistent": "workspace:^",
    "@deepseek-ai/dsh-tool-lsp": "workspace:^",
    "@deepseek-ai/dsh-tool-session-query": "workspace:^",
    "@deepseek-ai/dsh-tool-terminal": "workspace:^",
    "@deepseek-ai/dsh-workspace": "workspace:^",
    "@rin/agent-migration": "workspace:^",
    "@rin/computer-use": "workspace:^",
    "@rin/mcp": "workspace:^",
    "@rin/mcp-client": "workspace:^",
    "@rin/provider-probe": "workspace:^",
    "@rin/monitor": "workspace:^",
    "@rin/doctor": "workspace:^",
    "@rin/tasks": "workspace:^",
    "@rin/teams": "workspace:^",
    "@rin/repository": "workspace:^",
    "@rin/environment": "workspace:^",
    "@rin/filesystem": "workspace:^",
    "@rin/session-backup": "workspace:^",
    "@rin/knowledge": "workspace:^",
    "@rin/prompt-memory": "workspace:^",
    "@rin/skill-memory": "workspace:^",
    "@rin/session-search": "workspace:^",
    "@rin/evolution": "workspace:^",
    "@rin/token-optimization": "workspace:^",
    "@rin/codegraph": "workspace:^",
    "@rin/smart-pruning": "workspace:^",
    "@rin/notes": "workspace:^",
    "@rin/agents": "workspace:^",
    "@rin/plugins": "workspace:^",
    "@rin/brief": "workspace:^",
    "@rin/review": "workspace:^",
    "@rin/sandboxes": "workspace:^",
    "@rin/web-server": "workspace:^"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
